{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geneci.org/schemas/benchmark-manifest.schema.json",
  "title": "GENECI BenchmarkManifest",
  "description": "Top-level manifest indexing a generated benchmark package.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "profile",
    "organism",
    "requested_extras",
    "effective_extras",
    "inputs",
    "input_files",
    "runs",
    "tasks",
    "execution",
    "datasets",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "organism": { "type": "object" },
    "requested_extras": {
      "type": "array",
      "items": { "type": "string" }
    },
    "effective_extras": {
      "type": "array",
      "items": { "type": "string" }
    },
    "base_seed": { "type": ["integer", "null"] },
    "inputs": { "type": "object" },
    "input_files": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "simulator_id",
          "replicates",
          "base_seed",
          "replicate_seeds",
          "resolved_simulator_params"
        ],
        "properties": {
          "run_id": { "type": "string", "minLength": 1 },
          "simulator_id": { "type": "string", "minLength": 1 },
          "replicates": { "type": "integer", "minimum": 1 },
          "native_outputs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "base_seed": { "type": "integer" },
          "replicate_seeds": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "resolved_simulator_params": { "type": "object" }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "run_id",
          "simulator_id",
          "replicate_index",
          "seed",
          "dataset_id"
        ],
        "properties": {
          "task_id": { "type": "string", "minLength": 1 },
          "run_id": { "type": "string", "minLength": 1 },
          "simulator_id": { "type": "string", "minLength": 1 },
          "replicate_index": { "type": "integer", "minimum": 1 },
          "seed": { "type": "integer" },
          "dataset_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_parallel_tasks"],
      "properties": {
        "max_parallel_tasks": { "type": "integer", "minimum": 1 }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset_id",
          "run_id",
          "simulator_id",
          "seed",
          "path",
          "dataset_manifest",
          "ground_truth_manifest"
        ],
        "properties": {
          "dataset_id": { "type": "string", "minLength": 1 },
          "run_id": { "type": "string", "minLength": 1 },
          "simulator_id": { "type": "string", "minLength": 1 },
          "seed": { "type": "integer" },
          "path": { "type": "string", "minLength": 1 },
          "dataset_manifest": { "type": "string", "minLength": 1 },
          "ground_truth_manifest": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset_id",
          "run_id",
          "simulator_id",
          "expression_matrix",
          "global_network",
          "legacy_binary_matrix"
        ],
        "properties": {
          "dataset_id": { "type": "string", "minLength": 1 },
          "run_id": { "type": "string", "minLength": 1 },
          "simulator_id": { "type": "string", "minLength": 1 },
          "expression_matrix": { "type": "string", "minLength": 1 },
          "groups": { "type": ["string", "null"] },
          "lineage_tree": { "type": ["string", "null"] },
          "tf_list": { "type": ["string", "null"] },
          "prior_grn_by_group": { "type": ["string", "null"] },
          "native_outputs": {
            "type": "object",
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "global_network": { "type": "string", "minLength": 1 },
          "legacy_binary_matrix": { "type": "string", "minLength": 1 },
          "group_networks_dir": { "type": ["string", "null"] }
        }
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  }
}
