{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geneci.org/schemas/simulator-runs.schema.json",
  "title": "GENECI SimulatorRuns",
  "description": "Selected simulator instances for generate-v2 planning. A simulator can appear more than once with different run_id and params.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runs"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "simulator_id", "replicates", "params"],
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "simulator_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "params": {
            "type": "object"
          },
          "replicates": {
            "type": "integer",
            "minimum": 1
          },
          "native_outputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "base_seed": {
            "type": "integer",
            "minimum": 1
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  }
}
