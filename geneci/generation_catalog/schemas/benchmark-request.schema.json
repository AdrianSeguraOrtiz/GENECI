{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geneci.org/schemas/benchmark-request.schema.json",
  "title": "GENECI BenchmarkRequest",
  "description": "Top-level request contract for generate-v2 benchmark creation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "profile",
    "simulator_id",
    "replicates",
    "organism",
    "requested_extras",
    "simulator_params"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "profile": {
      "type": "string",
      "enum": [
        "bulk_steady_state",
        "bulk_time_series",
        "bulk_perturbational",
        "scrna_global",
        "scrna_grouped"
      ]
    },
    "simulator_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "input_files": {
      "type": "object",
      "default": {},
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "replicates": {
      "type": "integer",
      "minimum": 1
    },
    "organism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tax_id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["biological", "synthetic", "unknown"],
          "default": "synthetic"
        },
        "tax_id": {
          "anyOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requested_extras": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["groups", "lineage_tree", "tf_list", "prior_grn_by_group"]
      }
    },
    "simulator_params": {
      "type": "object"
    },
    "base_seed": {
      "type": "integer"
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  }
}
